# ==============================================================================
# Sports Court Booking Platform — Environment Configuration Template
# Copy this file to `.env` (and `backend/.env` if running backend standalone)
# and populate all secret placeholders before starting services.
# ==============================================================================

# PostgreSQL 16 (Docker & Migrations)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<your_postgres_superuser_password>
POSTGRES_DB=court_booking
POSTGRES_PORT=5432

# Application Role Connection (NOBYPASSRLS — strictly enforces Row-Level Security)
DATABASE_URL=postgresql://court_app:<your_app_role_password>@localhost:5432/court_booking?schema=public

# Isolated Worker & Platform Operations Connection
WORKER_DATABASE_URL=postgresql://<worker_role>:<your_worker_password>@localhost:5432/court_booking?schema=public

# Optional Migration / QA Runner Connection
SUPER_DATABASE_URL=postgresql://postgres:<your_postgres_superuser_password>@localhost:5432/court_booking

# Redis Cache & Realtime Locks
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# API & Frontend Ports
PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Cryptographic Signing Secrets (generate >= 32 random bytes per secret)
JWT_SECRET=<generate_32_byte_hex_jwt_secret>
OTP_SECRET=<generate_32_byte_hex_otp_hmac_secret>

# Bank Transfer Webhook Verification Secret (forwarded via x-webhook-secret)
BANK_WEBHOOK_SECRET=<generate_webhook_hmac_secret>

# Transactional Email Delivery ('local' for loopback dev preview, 'smtp' for live delivery)
AUTH_EMAIL_MODE=local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Dat San The Thao
